# ============================================================
# LLM Settings
# ============================================================
# Which provider to use: "groq" or "gemini"
LLM_PROVIDER=groq

# Groq Models (choose one):
# - llama-3.3-70b-versatile (best)
# - llama-3.1-8b-instant (fast)
# - mixtral-8x7b-32768 (long context)
# - gemma2-9b-it (lightweight)
