# Copy this file to .env and fill in your own values.
# Never commit your real .env file (it's already in .gitignore).

# --- Required API Keys ---
# Get a free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Get a free OpenWeatherMap key: https://openweathermap.org/api
WEATHER_API_KEY=your_openweathermap_api_key_here

# Get a free Groq key (used for PDF RAG chat): https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- App Settings ---
APP_NAME=AI Utility Agent
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# --- Gemini Settings ---
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=30

# --- PDF RAG Settings ---
# openai/gpt-oss-120b is Groq's current recommended production model.
# For a faster/cheaper option try openai/gpt-oss-20b.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4
RAG_TEMPERATURE=0.2
MAX_PDF_SIZE_MB=20
MAX_PDFS=10

# --- Tool Settings ---
REQUEST_TIMEOUT=10
SEARCH_MAX_RESULTS=5
WIKIPEDIA_SENTENCES=3

# --- CORS: comma-separated list of origins allowed to call the API ---
# Use * for local development, restrict to your deployed frontend URL in production
ALLOWED_ORIGINS=*

# --- Frontend: URL of the FastAPI backend ---
# Local dev: http://127.0.0.1:8000
# Production: your Render backend URL, e.g. https://ai-utility-agent.onrender.com
BACKEND_URL=http://127.0.0.1:8000
